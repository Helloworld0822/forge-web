fn method(request: int): string { return fw_method(request); }

fn path(request: int): string { return fw_path(request); }

fn header(request: int, name: string): string { return fw_header(request, name); }

fn query(request: int, name: string): string { return fw_query(request, name); }

fn body(request: int): string { return fw_body(request); }

fn ip(request: int): string { return fw_ip(request); }

fn segment(request: int, index: int): string { return fw_segment(request, index); }

