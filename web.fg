fn text(value: int): string { return fw_text(value); }

fn integer(value: int): int { return fw_integer(value); }

fn boolean(value: int): int { return fw_boolean(value); }

fn dump(value: int): string { return fw_dump(value); }

fn object(): int { return fw_object(); }

fn array(): int { return fw_array(); }

fn jstring(value: string): int { return fw_string(value); }

fn number(value: int): int { return fw_number(value); }

fn jbool(value: int): int { return fw_bool(value); }

fn set(value: int, key: string, child: int): int { return fw_set(value, key, child); }

fn push(value: int, child: int): int { return fw_push(value, child); }

