fn now(): int { return fw_now(); }

fn rate(key: string, maximum: int, seconds: int): int { return fw_rate(key, maximum, seconds); }

fn urlencode(value: string): string { return fw_urlencode(value); }

fn fetch(url: string, method: string, body: string, bearer: string): int { return fw_fetch(url, method, body, bearer); }

fn jwt_verify(token: string, secret: string): int { return fw_jwt_verify(token, secret); }

fn jwt_sign(claims: int, secret: string): string { return fw_jwt_sign(claims, secret); }

fn read(path: string): string { return fw_read(path); }

fn field_text(value: int, key: string): string { return text(get(value, key)); }
fn field_int(value: int, key: string): int { return integer(get(value, key)); }
fn present(value: int, key: string): int { return kind(get(value, key)) != 0; }
fn required(value: int, key: string, expected: int): int { return kind(get(value, key)) == expected; }
fn optional(value: int, key: string, expected: int): int {
    let actual: int = kind(get(value, key));
    return actual == 0 || actual == expected;
}
fn string_array(value: int): int {
    if (kind(value) != 5) { return 0; }
    let index: int = 0;
    while (index < count(value)) {
        if (kind(at(value, index)) != 3) { return 0; }
        index = index + 1;
    }
    return 1;
}
fn error(request: int, status: int, code: string): int {
    let value: int = object();
    set(value, "error", jstring(code));
    return respond(request, status, dump(value));
}
fn validation(request: int, message: string): int {
    let value: int = object();
    set(value, "error", jstring("validation"));
    set(value, "message", jstring(message));
    return respond(request, 400, dump(value));
}
fn request_json(request: int): int {
    let content_type: string = lower(header(request, "Content-Type"));
    if (starts(content_type, "application/json") == 0 && str_contains(content_type, "+json") == 0) { return 0; }
    let value: int = parse(body(request));
    if (kind(value) != 4) { return 0; }
    return value;
}

fn normalize_ip(value: string): string { return fw_normalize_ip(value); }
fn sort(array: int, key: string): int { return fw_sort(array, key); }
fn fetch_many(urls: int, bearer: string): int { return fw_fetch_many(urls, bearer); }

fn has(value: int, key: string): int { return fw_has(value, key); }
fn cookie(request: int, name: string): string { return fw_cookie(request, name); }
fn set_cookie(request: int, name: string, value: string, age: int, secure: int): int { return fw_set_cookie(request, name, value, age, secure); }
