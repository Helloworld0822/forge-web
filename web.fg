fn content_type(request: int, value: string): int { return fw_content_type(request, value); }

fn trim(value: string): string { return fw_trim(value); }

fn chars(value: string): int { return fw_chars(value); }

fn valid(value: string, kind: string): int { return fw_valid(value, kind); }

fn lower(value: string): string { return fw_lower(value); }

fn equal(a: string, b: string): int { return fw_equal(a, b); }

fn starts(value: string, prefix: string): int { return fw_starts(value, prefix); }

fn part(value: string, index: int): string { return fw_part(value, index); }

